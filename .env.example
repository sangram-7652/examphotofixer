# ExamPhotoFixer environment. Placeholders only: never commit real values or a .env file.
# There are NO secrets in V1. NEXT_PUBLIC_* values are inlined into client JavaScript at build
# time, so they must never hold credentials. Rebuild after changing any of them.
# Full table: docs/DEPLOYMENT.md.

# --- Public (client-visible, build-time) -------------------------------------------------

# Canonical production origin: https, no trailing slash. Used for canonical URLs, Open Graph,
# robots.txt and the sitemap. Unset → https://examphotofixer.com.
NEXT_PUBLIC_SITE_URL=https://examphotofixer.com

# Exactly "true" allows search engine indexing (robots Allow: /, no noindex). Set it on the
# production deployment only; leave unset for local, preview and staging builds.
NEXT_PUBLIC_SITE_INDEXABLE=

# Public contact address shown on /privacy (launch requirement). Unset → no address shown.
NEXT_PUBLIC_CONTACT_EMAIL=

# "true" turns every analytics event into a no-op (kill switch; see docs/ANALYTICS.md).
NEXT_PUBLIC_ANALYTICS_DISABLED=

# --- Server-only (not exposed to client JavaScript) --------------------------------------

# Optional Google Search Console HTML-tag verification token. Rendered publicly as a meta tag,
# so not a secret, but set it in the hosting environment rather than in git.
GOOGLE_SITE_VERIFICATION=

# --- Test-only: never set in production --------------------------------------------------
# ENGINE_HARNESS=1 serves the /dev/image-engine test page (Playwright sets it for e2e).
