# Canonical production origin, no trailing slash. Used for canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=https://examphotofixer.com

# Must be exactly "true" to allow search engine indexing. Leave unset until tools are live.
NEXT_PUBLIC_SITE_INDEXABLE=

# Optional: Google Search Console HTML-tag verification token (set in the hosting env only).
GOOGLE_SITE_VERIFICATION=
